{
  "name": "SAE_PropJV",
  "version": "1.0.0",
  "description": "Prop JV Monorepo",
  "main": "index.js",
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:api": "pnpm --filter api-master dev",
    "dev:server": "pnpm --filter game-server dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,API,SERVER\" -c \"cyan.bold,magenta.bold,yellow.bold\" \"pnpm dev:client\" \"pnpm dev:api\" \"pnpm dev:server\"",
    "build": "pnpm --recursive run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module"
}
